{
  "name": "@agentdeck/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --env-file=../../.env --watch dist/src/main.js\"",
    "echo": "tsc -p tsconfig.build.json && node --env-file=../../.env dist/scripts/run-echo.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentdeck/shared": "workspace:*",
    "@nestjs/common": "^12.4.1",
    "@nestjs/core": "^12.4.1",
    "@nestjs/event-emitter": "^12.0.2",
    "@nestjs/platform-express": "^12.4.1",
    "@nestjs/schedule": "^12.0.3",
    "@supabase/supabase-js": "^2.119.0",
    "jose": "^6.2.16",
    "nestjs-pino": "^5.3.1",
    "openai": "^7.53.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.4.1",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "pino-pretty": "^13.2.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
