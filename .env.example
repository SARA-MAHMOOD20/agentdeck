# =====================================================================
#  agentdeck — environment variables
#  Fill in the values after the "=" (no quotes, no spaces around "=").
#  Template: copy to .env (cp .env.example .env) and fill in. Safe to commit — no secrets here.
#  Run `bash scripts/check-env.sh` to see what's filled in (values stay hidden).
# =====================================================================


# ---------------------------------------------------------------------
#  PHASE 1 — needed now
# ---------------------------------------------------------------------

# --- LLM (Gemini) — https://aistudio.google.com ---
# "Get API key" → Create API key
LLM_API_KEY=
# Gemini's OpenAI-compatible endpoint (pre-filled; verified in Phase 1)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Exact model ID strings from AI Studio's model list
LLM_MODEL_FAST=gemini-3.1-flash-lite
LLM_MODEL_SMART=gemini-3.5-flash-lite
# AI Studio → Usage / Rate limits. Set slightly BELOW the real numbers.
LLM_RPM_LIMIT=13
LLM_RPD_LIMIT=450

# --- Supabase — https://supabase.com/dashboard → your project ---
# Project Settings → Data API → Project URL
SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings → API Keys → Publishable key (sb_publishable_...) — safe for the browser
SUPABASE_PUBLISHABLE_KEY=
# Project Settings → API Keys → Secret key (sb_secret_...) — backend only, TOP SECRET
SUPABASE_SECRET_KEY=
# Supabase → Connect → "Session pooler" → URI. Replace [YOUR-PASSWORD] with your DB password.
# Only used to apply migrations (never by the running app).
SUPABASE_DB_URL=

# --- App ---
# Generate with:  openssl rand -base64 32     (back this up somewhere safe!)
ENCRYPTION_KEY=
# IANA timezone name (not "GMT+5")
TIMEZONE=Asia/Karachi
DASHBOARD_ALLOWED_EMAIL=you@example.com
# Local dev defaults — changed to real URLs at deploy time (Phase 8)
DASHBOARD_URL=http://localhost:5173
API_URL=http://localhost:3000


# ---------------------------------------------------------------------
#  PHASE 2 — Discord   (https://discord.com/developers/applications)
#  IDs: Discord Settings → Advanced → Developer Mode, then right-click → Copy ID
# ---------------------------------------------------------------------
# Bot tab → Reset Token (also enable "Message Content Intent")
DISCORD_BOT_TOKEN=
# Right-click your own name → Copy User ID
DISCORD_OWNER_ID=
# Right-click the server icon → Copy Server ID
DISCORD_GUILD_ID=
# Right-click each channel → Copy Channel ID
DISCORD_CHANNEL_UNI_EMAIL=
DISCORD_CHANNEL_CALENDAR=
DISCORD_CHANNEL_WHATSAPP=
DISCORD_CHANNEL_CHAT=
DISCORD_CHANNEL_ERRORS=


# ---------------------------------------------------------------------
#  PHASE 3 — Google Gmail + Calendar   (https://console.cloud.google.com)
#  APIs & Services → Credentials → OAuth client ID (Web application)
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must also be added under "Authorized redirect URIs" in the OAuth client
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Comma-separated university email domains
UNI_EMAIL_DOMAINS=


# ---------------------------------------------------------------------
#  PHASE 7 — WhatsApp (optional privacy mode; leave empty to use Gemini)
# ---------------------------------------------------------------------
WHATSAPP_LLM_BASE_URL=
WHATSAPP_LLM_MODEL=

# ---------------------------------------------------------------------
#  Optional
# ---------------------------------------------------------------------
# PORT=3000
# LOG_LEVEL=info          # trace | debug | info | warn | error
# NODE_ENV=development
